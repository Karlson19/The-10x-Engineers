# Chrysmec Auto Center environment variables.
#
# Copy the API block into apps/api/.env and the web block into apps/web/.env.local.
# Never commit a real .env file. Production values live in the Render, Vercel and
# Neon dashboards.

# ---------------------------------------------------------------------------
# API (apps/api/.env)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Use the pooled Neon string in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chrysmec?schema=public"

# Signing secret for the 15 minute access token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"

# Signing secret for the 7 day refresh token. Must differ from the access secret.
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# A separate database for the test suite, which creates and deletes accounts,
# bookings and payments as it runs.
#
# Without this the tests refuse to start against anything but a database on
# your own machine, because sharing one with the running app makes runs fail
# for reasons that have nothing to do with the code.
#
# In Neon, branch the project: a branch is free, takes seconds, and starts as a
# copy of the schema. Then apply migrations to it once:
#   pnpm --filter api exec prisma migrate deploy
TEST_DATABASE_URL=""

# Paystack secret key. Starts with sk_test_ in test mode, sk_live_ in production.
#
# The API needs only this one. The public key is for card forms rendered in a
# browser, and this product never renders one: the customer is sent to
# Paystack's own hosted page, so no card number ever reaches our code.
#
# Set the webhook in the Paystack dashboard to:
#   https://<your-api-host>/api/v1/payments/webhook
# That endpoint is what actually settles a payment. The redirect a customer
# comes back on is confirmed against Paystack separately and is never trusted
# on its own.
#
# Leave this empty and card payments simply stay switched off: the rest of the
# app works, and asking to pay answers with a plain message saying so.
PAYSTACK_SECRET_KEY=""

# Africa's Talking sandbox credentials for SMS (Phase 6).
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"

# Port the Express server listens on. Render sets this for you.
PORT="4000"

# development | test | production
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Web (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the API, including the version prefix.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
