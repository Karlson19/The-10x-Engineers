# Chrysmec Auto Center environment variables.
#
# Copy the API block into apps/api/.env and the web block into apps/web/.env.local.
# Never commit a real .env file. Production values live in the Render, Vercel and
# Neon dashboards.

# ---------------------------------------------------------------------------
# API (apps/api/.env)
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Use the pooled Neon string in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chrysmec?schema=public"

# Signing secret for the 15 minute access token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"

# Signing secret for the 7 day refresh token. Must differ from the access secret.
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN="http://localhost:3000"

# Paystack test mode secret key (Phase 6). Starts with sk_test_ in test mode.
PAYSTACK_SECRET_KEY=""

# Africa's Talking sandbox credentials for SMS (Phase 6).
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME="sandbox"

# Port the Express server listens on. Render sets this for you.
PORT="4000"

# development | test | production
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Web (apps/web/.env.local)
# ---------------------------------------------------------------------------

# Base URL of the API, including the version prefix.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
