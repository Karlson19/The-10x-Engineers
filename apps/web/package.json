{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Chrysmec Auto Center progressive web app",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @chrysmec/shared build && next build",
    "start": "next start --port 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chrysmec/shared": "workspace:*",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.22",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "serwist": "^9.5.12",
    "simple-icons": "^16.27.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
