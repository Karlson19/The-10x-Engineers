generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  STAFF
  MANAGEMENT
}

enum Section {
  MECHANICAL
  ELECTRICAL
}

enum RequestStatus {
  SUBMITTED
  SCHEDULED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum JobStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum LineType {
  PART
  LABOUR
}

enum PaymentMethod {
  PAYSTACK
  MOMO
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String
  role         Role     @default(CLIENT)
  section      Section?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles        Vehicle[]
  serviceRequests ServiceRequest[] @relation("ClientRequests")
  assignedJobs    Job[]            @relation("StaffJobs")
  notifications   Notification[]
  stockMovements  StockMovement[]  @relation("RecordedStockMovements")

  @@index([role])
}

model Vehicle {
  id             String   @id @default(uuid())
  ownerId        String
  make           String
  model          String
  year           Int
  registrationNo String
  notes          String?
  createdAt      DateTime @default(now())

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([ownerId])
}

model ServiceRequest {
  id                String        @id @default(uuid())
  clientId          String
  vehicleId         String
  section           Section
  status            RequestStatus @default(SUBMITTED)
  preferredDateTime DateTime
  locationText      String
  latitude          Float?
  longitude         Float?
  symptomCategory   String
  symptomDetails    Json
  estimatedCost     Decimal?      @db.Decimal(10, 2)
  clientRequestId   String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client            User               @relation("ClientRequests", fields: [clientId], references: [id])
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id])
  job               Job?
  requestedServices RequestedService[]
  payments          Payment[]
  statusEvents      StatusEvent[]
  feedback          Feedback?

  @@index([clientId])
  @@index([status])
  @@index([section])
}

model Job {
  id               String    @id @default(uuid())
  serviceRequestId String    @unique
  assignedStaffId  String
  status           JobStatus @default(ASSIGNED)
  startedAt        DateTime?
  completedAt      DateTime?
  diagnosisNotes   String?
  workSummary      String?
  createdAt        DateTime  @default(now())

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  assignedStaff  User            @relation("StaffJobs", fields: [assignedStaffId], references: [id])
  workLog        WorkLogEntry[]
  stockMovements StockMovement[]

  @@index([assignedStaffId])
}

model ServiceCatalogItem {
  id          String  @id @default(uuid())
  name        String
  description String
  section     Section
  basePrice   Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true)

  requestedServices RequestedService[]
}

model RequestedService {
  id                   String @id @default(uuid())
  serviceRequestId     String
  serviceCatalogItemId String

  serviceRequest     ServiceRequest     @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id])

  @@unique([serviceRequestId, serviceCatalogItemId])
}

model InventoryItem {
  id              String  @id @default(uuid())
  name            String
  sku             String  @unique
  section         Section
  /// What is on the shelf. A cached total: every change to it is written as a
  /// StockMovement in the same transaction, and the ledger is what can be
  /// audited. Kept on the row because the low stock report and the parts picker
  /// both need it on every read, and replaying the ledger for that would be
  /// wasteful.
  quantityInStock Int     @default(0)
  /// What a unit is worth today, held as the weighted average of what is
  /// actually on the shelf. Recalculated on every receipt rather than typed in,
  /// so it cannot drift from what was paid.
  unitCost        Decimal @db.Decimal(10, 2)
  reorderLevel    Int     @default(5)
  /// A photograph of the part. Either one shipped with the app under /parts, or
  /// a link to the workshop's own photo of what is actually on the shelf.
  imageUrl        String?

  workLogEntries WorkLogEntry[]
  stockMovements StockMovement[]
}

enum StockMovementType {
  /// Stock bought in, carrying what was paid for it.
  RECEIPT
  /// Taken out of stock for a job.
  CONSUMPTION
  /// A work log line was removed, so the part went back on the shelf.
  RETURN
  /// A stock take correction, breakage or write off.
  ADJUSTMENT
}

/// Every movement of stock, in or out, as an immutable row.
///
/// This is the record the workshop is actually run from. Without it the only
/// thing stored was a running total that could be changed with no explanation:
/// a restock recorded no price, so what a part cost over time was unknowable,
/// and a discrepancy at a stock take could never be traced to what caused it.
///
/// Rows are never updated or deleted. A mistake is corrected by posting the
/// opposite movement, so the history stays honest.
model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String
  type            StockMovementType
  /// Signed. Positive puts stock on the shelf, negative takes it off.
  quantity        Int
  /// What one unit was worth for this movement. On a receipt it is what was
  /// paid, which is what makes price history possible. On a consumption it is
  /// the weighted average at the moment it was taken, so the job is costed at
  /// what that stock actually cost rather than at a later price.
  unitCost        Decimal           @db.Decimal(10, 2)
  /// The shelf count after this movement, so a stock take can be reconciled at
  /// any point without replaying everything before it.
  balanceAfter    Int
  /// Supplier invoice number on a receipt, stock take reference on an
  /// adjustment.
  reference       String?
  note            String?
  /// Which supplier it was bought from, on a receipt.
  supplier        String?
  /// The job it went out on, when it left for one.
  jobId           String?
  /// Set on a consumption so removing the work log line can find its movement
  /// and post the matching return.
  workLogEntryId  String?
  /// Who posted it. Stock is money, so every movement has a name against it.
  recordedById    String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  recordedBy    User?         @relation("RecordedStockMovements", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@index([type])
  @@index([jobId])
}

model WorkLogEntry {
  id              String   @id @default(uuid())
  jobId           String
  inventoryItemId String?
  lineType        LineType
  description     String
  quantity        Int
  unitCost        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@index([jobId])
}

model Payment {
  id               String        @id @default(uuid())
  serviceRequestId String
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("GHS")
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  reference        String        @unique
  createdAt        DateTime      @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id])
}

model StatusEvent {
  id               String   @id @default(uuid())
  serviceRequestId String
  fromStatus       String?
  toStatus         String
  note             String?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
}

model Feedback {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
